# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.


# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
coverage/
playwright-report/
test-results/

# Next.js
.next/
out/

# Production builds
build/
dist/

# Environment variables and secrets
.env*
!.env.example
!.env.*.example

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Miscellaneous
.DS_Store
Thumbs.db
*.pem

# IDEs and editors
.vscode/
.idea/

# Prisma
# Keep schema and migrations tracked.
# Ignore only generated local artifacts if needed.

# Local databases
*.sqlite
*.sqlite-journal
*.db

# Temporary files
*.tmp
*.bak
